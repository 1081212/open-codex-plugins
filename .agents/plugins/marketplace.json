{
  "name": "open-codex-plugins",
  "interface": {
    "displayName": "Open Codex Plugins"
  },
  "plugins": [
    {
      "name": "lark-docs",
      "source": {
        "source": "local",
        "path": "./plugins/lark-docs"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_USE"
      },
      "category": "Productivity"
    },
    {
      "name": "codex-usage-dashboard",
      "source": {
        "source": "local",
        "path": "./plugins/codex-usage-dashboard"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity"
    }
  ]
}
